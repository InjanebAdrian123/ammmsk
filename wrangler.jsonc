{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ammmsk",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9875bbff-1498-4e86-bd52-48cb9df8e9c6","database_name": "pll" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b91517b4807c4775a85bc7c0bf07baa6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
